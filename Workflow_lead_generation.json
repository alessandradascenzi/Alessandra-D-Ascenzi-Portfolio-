    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "models/gemini-2.5-flash",
          "mode": "list",
          "cachedResultName": "models/gemini-2.5-flash"
        },
        "messages": {
          "values": [
            {
              "content": "=Sei un estrattore di dati JSON altamente preciso. Il tuo unico compito è analizzare l'array JSON di risultati di ricerca Google e restituire esclusivamente un array JSON standardizzato. Non aggiungere testo descrittivo o caratteri aggiuntivi prima o dopo l'array. \n\n**OUTPUT RICHIESTO:** Array JSON (inizia con [ e termina con ]). \n\n**REGOLE DI ESTRAZIONE:** Per ogni oggetto all'interno della sezione 'items' dell'input, crea un nuovo oggetto con questi campi: \n1. \"Name\": [Estrai il valore dal campo 'title']\n2. \"Snippet\": [Estrai il valore dal campo 'snippet']\n3. \"ProfileURL\": [Estrai il valore dal campo 'link']\n4. \"SearchKeyword\": [Usa il valore statico: 'Recruiter Tech Italia']\n\n**REGOLE DI FILTRO:** \n*Includi solo i risultati dove il campo 'link' contiene la stringa esatta: \"linkedin.com/in/\". \n*Se non ci sono risultati validi, restituisci: []. \n\n**Array di input da processare:** {{JSON.stringify($input.all())}}"
            }
          ]
        },
        "jsonOutput": true,
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1,
      "position": [
        352,
        -160
      ],
      "id": "YOUR_GEMINI_AGENT_ID",
      "name": "LLM 1: Estrazione profili",
      "credentials": {
        "googlePalmApi": {
          "id": "YOUR_GOOGLE_PALM_API_ID",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "models/gemini-2.5-flash",
          "mode": "list",
          "cachedResultName": "models/gemini-2.5-flash"
        },
        "messages": {
          "values": [
            {
              "content": "=Sei un valutatore esperto. Valuta quanto il profilo estratto è vicino alla chiave di ricerca. Il punteggio deve essere un numero INTERO DA 0 a 5.\n\nProfilo: {{ $json.Name }} - {{ $json.Snippet }}\nChiave di ricerca: {{ $json.SearchKeyword }}\n\nATTENZIONE: Restituisci la risposta SOLO ed ESCLUSIVAMENTE come stringa JSON valida. NON AGGIUNGERE TESTO, NOTE, INTRODUZIONI o CARATTERI SPECIALI.\n\nFormato di output richiesto:\n{\n\"score\": N\n}\n\n"
            }
          ]
        },
        "jsonOutput": true,
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1,
      "position": [
        944,
        -160
      ],
      "id": "YOUR_GEMINI_AGENT_ID_2",
      "name": "LLM 2: assegna punteggio",
      "credentials": {
        "googlePalmApi": {
          "id": "YOUR_GOOGLE_PALM_API_ID",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const staticKeyword = \"Recruiter Tech Italia\";\nconst googleApiKey = \"YOUR_GOOGLE_API_KEY\";\nconst googleCSEId = \"YOUR_GOOGLE_CSE_ID\";\n\n// NUOVA QUERY: Rimuove le virgolette doppie per permettere a Google di cercare le parole in qualsiasi ordine.\n// Se necessario, puoi sostituire il valore 'staticKeyword' con qualcosa di più generico come \"Recruiter Tech\"\nconst googleSearchQuery = `site:linkedin.com/in/ ${staticKeyword}`;\n\n// Aggiunge i campi all'oggetto item di output\n$json.StaticKeyword = staticKeyword;\n$json.GoogleApiKey = googleApiKey;\n$json.GoogleCSEId = googleCSEId;\n$json.GoogleSearchQuery = googleSearchQuery;\n\n// Ritorna l'item modificato\nreturn $json; \n\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -64,
        -16
      ],
      "id": "60da52bb-9a41-4c0b-9ce5-35354cc744e8",
      "name": "Preparazione API e Keyword"
    },
    {
      "parameters": {
        "jsCode": "// Passo 1: Definisci il percorso del dato grezzo (che sappiamo essere corretto)\n// Usiamo un blocco try-catch per prevenire crash se il percorso cambia leggermente\nlet rawJsonString;\ntry {\n    // Il percorso che ha funzionato in precedenza\n    rawJsonString = $json.content.parts[0].text;\n} catch (e) {\n    // Se fallisce (percorso alternativo nel caso in cui il nodo Gemini incapsuli l'output in un array)\n    try {\n        rawJsonString = $json[0].content.parts[0].text;\n    } catch (e) {\n        // Se tutto fallisce, restituiamo un array vuoto per evitare il blocco del workflow\n        return [];\n    }\n}\n\n// Passo 2: Analizza la stringa JSON in un array di oggetti JavaScript\nconst recordsArray = JSON.parse(rawJsonString);\n\n// Passo 3: Formatta l'array nel formato item di output di n8n (il vero \"split\").\n// Ogni record viene incapsulato in { json: record } per diventare un item separato.\nconst outputItems = recordsArray.map(record => ({\n    json: record \n}));\n\n// Restituisci l'array di item multipli (10 item separati).\nreturn outputItems;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
